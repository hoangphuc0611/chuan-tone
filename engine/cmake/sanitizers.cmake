function(tc_apply_sanitizer target)
  if(NOT TC_SANITIZER)
    return()
  endif()
  set(flags -fsanitize=${TC_SANITIZER} -fno-omit-frame-pointer)
  if(TC_SANITIZER STREQUAL "undefined")
    list(APPEND flags -fno-sanitize-recover=undefined)
  endif()
  target_compile_options(${target} PRIVATE ${flags})
  target_link_options(${target} PRIVATE -fsanitize=${TC_SANITIZER})
endfunction()
