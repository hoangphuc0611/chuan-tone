{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "TC_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "host",
      "displayName": "Host (Debug) – build + test",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "host-release",
      "displayName": "Host (Release) – benchmark",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "TC_BUILD_BENCH": "ON" }
    },
    {
      "name": "host-asan",
      "displayName": "Host + AddressSanitizer",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "TC_SANITIZER": "address" }
    },
    {
      "name": "host-ubsan",
      "displayName": "Host + UndefinedBehaviorSanitizer",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "TC_SANITIZER": "undefined" }
    },
    {
      "name": "host-tsan",
      "displayName": "Host + ThreadSanitizer",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "TC_SANITIZER": "thread" }
    },
    {
      "name": "android-arm64",
      "displayName": "Android arm64-v8a (cần ANDROID_NDK_HOME)",
      "inherits": "base",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-28",
        "ANDROID_STL": "c++_static"
      }
    },
    {
      "name": "android-x64",
      "displayName": "Android x86_64 (emulator)",
      "inherits": "android-arm64",
      "cacheVariables": { "ANDROID_ABI": "x86_64" }
    }
  ],
  "buildPresets": [
    { "name": "host", "configurePreset": "host" },
    { "name": "host-release", "configurePreset": "host-release" },
    { "name": "host-asan", "configurePreset": "host-asan" },
    { "name": "host-ubsan", "configurePreset": "host-ubsan" },
    { "name": "host-tsan", "configurePreset": "host-tsan" },
    { "name": "android-arm64", "configurePreset": "android-arm64" },
    { "name": "android-x64", "configurePreset": "android-x64" }
  ],
  "testPresets": [
    {
      "name": "host",
      "configurePreset": "host",
      "output": { "outputOnFailure": true }
    },
    { "name": "host-asan", "inherits": "host", "configurePreset": "host-asan" },
    { "name": "host-ubsan", "inherits": "host", "configurePreset": "host-ubsan" },
    { "name": "host-tsan", "inherits": "host", "configurePreset": "host-tsan" }
  ]
}
