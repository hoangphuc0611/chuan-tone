{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "TC_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "host",
      "displayName": "Host (Debug) – build + test",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "host-release",
      "displayName": "Host (Release) – benchmark",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TC_BUILD_BENCH": "ON"
      }
    },
    {
      "name": "host-asan",
      "displayName": "Host + AddressSanitizer",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TC_SANITIZER": "address"
      }
    },
    {
      "name": "host-ubsan",
      "displayName": "Host + UndefinedBehaviorSanitizer",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TC_SANITIZER": "undefined"
      }
    },
    {
      "name": "host-tsan",
      "displayName": "Host + ThreadSanitizer",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TC_SANITIZER": "thread"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host",
      "configurePreset": "host"
    },
    {
      "name": "host-release",
      "configurePreset": "host-release"
    },
    {
      "name": "host-asan",
      "configurePreset": "host-asan"
    },
    {
      "name": "host-ubsan",
      "configurePreset": "host-ubsan"
    },
    {
      "name": "host-tsan",
      "configurePreset": "host-tsan"
    }
  ],
  "testPresets": [
    {
      "name": "host",
      "configurePreset": "host",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "host-asan",
      "inherits": "host",
      "configurePreset": "host-asan"
    },
    {
      "name": "host-ubsan",
      "inherits": "host",
      "configurePreset": "host-ubsan"
    },
    {
      "name": "host-tsan",
      "inherits": "host",
      "configurePreset": "host-tsan"
    }
  ]
}
